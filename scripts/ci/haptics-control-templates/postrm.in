#!/bin/sh
set -eu
umask 022

KERNEL_RELEASE=@KERNEL_RELEASE@
MANAGED_WANT_TARGET=/usr/lib/systemd/system/tb321fu-haptics.service
MANAGED_WANT_STATE_MAX_BYTES=256

die()
{
	printf '%s\n' "tb321fu-haptics postrm: $*" >&2
	exit 1
}

ROOT=${DPKG_ROOT:-}
case "$ROOT" in
	''|/*) ;;
	*) die 'DPKG_ROOT must be empty or absolute' ;;
esac

root_path()
{
	printf '%s%s\n' "$ROOT" "$1"
}

require_command()
{
	command -v "$1" >/dev/null 2>&1 || die "required command is unavailable: $1"
}

run_systemctl()
{
	if [ -n "$ROOT" ]; then
		systemctl "--root=$ROOT" "$@"
	else
		systemctl "$@"
	fi
}

systemd_manager_running()
{
	[ -z "$ROOT" ] && [ -d /run/systemd/system ]
}

remove_managed_want()
{
	want=$(root_path "/etc/systemd/system/multi-user.target.wants/$1")
	state=$(root_path /var/lib/tb321fu-haptics/managed-want)
	[ -e "$state" ] || [ -L "$state" ] || return 0
	read_managed_want_state "$state"
	target=$managed_want_state_target
	if [ -L "$want" ]; then
		current_target=$(readlink "$want") ||
			die "cannot read package-managed systemd want: $want"
		if [ "$current_target" = "$target" ]; then
			rm -f -- "$want" ||
				die "cannot remove package-managed systemd want: $want"
		else
			printf '%s\n' "tb321fu-haptics postrm: preserving modified systemd want: $want" >&2
		fi
	elif [ -e "$want" ]; then
		printf '%s\n' "tb321fu-haptics postrm: preserving non-symlink systemd want: $want" >&2
	fi
	rm -f -- "$state" || die "cannot remove managed systemd-want state: $state"
}

read_managed_want_state()
{
	managed_want_state=$1
	managed_want_state_target=
	[ -f "$managed_want_state" ] && [ ! -L "$managed_want_state" ] ||
		die "managed systemd-want state is not a regular file: $managed_want_state"
	state_dir=$(dirname -- "$managed_want_state")
	[ -d "$state_dir" ] && [ ! -L "$state_dir" ] ||
		die "managed systemd-want state parent is not a real directory: $state_dir"
	state_sample=$(mktemp "$state_dir/.managed-want-state.XXXXXX") ||
		die "cannot create bounded managed systemd-want state sample"
	if ! dd if="$managed_want_state" of="$state_sample" bs=1 \
		count=$((MANAGED_WANT_STATE_MAX_BYTES + 1)) 2>/dev/null; then
		rm -f -- "$state_sample"
		die "cannot read managed systemd-want state: $managed_want_state"
	fi
	state_bytes=$(wc -c < "$state_sample") || {
		rm -f -- "$state_sample"
		die "cannot measure managed systemd-want state: $managed_want_state"
	}
	if [ "$state_bytes" -gt "$MANAGED_WANT_STATE_MAX_BYTES" ]; then
		rm -f -- "$state_sample"
		die "managed systemd-want state exceeds the size limit: $managed_want_state"
	fi
	if ! printf '%s\n' "$MANAGED_WANT_TARGET" | cmp -s "$state_sample" -; then
		rm -f -- "$state_sample"
		die "managed systemd-want state is malformed or has an unexpected target: $managed_want_state"
	fi
	rm -f -- "$state_sample"
	managed_want_state_target=$MANAGED_WANT_TARGET
}

reload_systemd_if_running()
{
	if systemd_manager_running; then
		run_systemctl daemon-reload
	fi
}

reload_udev_if_running()
{
	if [ -z "$ROOT" ] && [ -S /run/udev/control ]; then
		require_command udevadm
		udevadm control --reload-rules
	fi
}

depmod_target()
{
	if [ -n "$ROOT" ]; then
		depmod -b "$ROOT" -a "$KERNEL_RELEASE"
	else
		depmod -a "$KERNEL_RELEASE"
	fi
}

case "${1:-}" in
	remove|purge)
		action=remove
		;;
	abort-upgrade|abort-deconfigure|abort-install|failed-upgrade)
		action=recover
		;;
	*) exit 0 ;;
esac

require_command cmp
require_command dd
require_command mktemp
require_command dirname

if [ "$action" = remove ]; then
	remove_managed_want tb321fu-haptics.service
fi
reload_systemd_if_running
reload_udev_if_running

modules_dir=$(root_path "/usr/lib/modules/$KERNEL_RELEASE")
if [ -d "$modules_dir" ]; then
	require_command depmod
	depmod_target
fi
