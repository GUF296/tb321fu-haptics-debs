#!/bin/sh
set -eu
umask 022

KERNEL_RELEASE=@KERNEL_RELEASE@
MANAGED_WANT_TARGET=/usr/lib/systemd/system/tb321fu-haptics.service

die()
{
	printf '%s\n' "tb321fu-haptics postrm: $*" >&2
	exit 1
}

ROOT=${DPKG_ROOT:-}
case "$ROOT" in
	''|/*) ;;
	*) die 'DPKG_ROOT must be empty or absolute' ;;
esac

root_path()
{
	printf '%s%s\n' "$ROOT" "$1"
}

require_command()
{
	command -v "$1" >/dev/null 2>&1 || die "required command is unavailable: $1"
}

run_systemctl()
{
	if [ -n "$ROOT" ]; then
		systemctl "--root=$ROOT" "$@"
	else
		systemctl "$@"
	fi
}

systemd_manager_running()
{
	[ -z "$ROOT" ] && [ -d /run/systemd/system ]
}

remove_managed_want()
{
	want=$(root_path "/etc/systemd/system/multi-user.target.wants/$1")
	state=$(root_path /var/lib/tb321fu-haptics/managed-want)
	[ -e "$state" ] || [ -L "$state" ] || return 0
	[ -f "$state" ] && [ ! -L "$state" ] ||
		die "managed systemd-want state is not a regular file: $state"
	target=$(cat "$state")
	[ -n "$target" ] && [ "$(wc -l < "$state")" -eq 1 ] ||
		die "managed systemd-want state is malformed: $state"
	[ "$target" = "$MANAGED_WANT_TARGET" ] ||
		die "managed systemd-want state has an unexpected target: $state"
	if [ -L "$want" ]; then
		current_target=$(readlink "$want") ||
			die "cannot read package-managed systemd want: $want"
		if [ "$current_target" = "$target" ]; then
			rm -f -- "$want" ||
				die "cannot remove package-managed systemd want: $want"
		else
			printf '%s\n' "tb321fu-haptics postrm: preserving modified systemd want: $want" >&2
		fi
	elif [ -e "$want" ]; then
		printf '%s\n' "tb321fu-haptics postrm: preserving non-symlink systemd want: $want" >&2
	fi
	rm -f -- "$state" || die "cannot remove managed systemd-want state: $state"
}

reload_systemd_if_running()
{
	if systemd_manager_running; then
		run_systemctl daemon-reload
	fi
}

reload_udev_if_running()
{
	if [ -z "$ROOT" ] && [ -S /run/udev/control ]; then
		require_command udevadm
		udevadm control --reload-rules
	fi
}

depmod_target()
{
	if [ -n "$ROOT" ]; then
		depmod -b "$ROOT" -a "$KERNEL_RELEASE"
	else
		depmod -a "$KERNEL_RELEASE"
	fi
}

case "${1:-}" in
	remove|purge) ;;
	*) exit 0 ;;
esac

remove_managed_want tb321fu-haptics.service
reload_systemd_if_running
reload_udev_if_running

modules_dir=$(root_path "/usr/lib/modules/$KERNEL_RELEASE")
if [ -d "$modules_dir" ]; then
	require_command depmod
	depmod_target
fi
