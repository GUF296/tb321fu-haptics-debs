#!/bin/sh
set -eu
umask 022

KERNEL_RELEASE=@KERNEL_RELEASE@
MANAGED_WANT_TARGET=/usr/lib/systemd/system/tb321fu-haptics.service
MANAGED_WANT_STATE_MAX_BYTES=256

die()
{
	printf '%s\n' "tb321fu-haptics postinst: $*" >&2
	exit 1
}

ROOT=${DPKG_ROOT:-}
case "$ROOT" in
	''|/*) ;;
	*) die 'DPKG_ROOT must be empty or absolute' ;;
esac

root_path()
{
	printf '%s%s\n' "$ROOT" "$1"
}

require_command()
{
	command -v "$1" >/dev/null 2>&1 || die "required command is unavailable: $1"
}

run_systemctl()
{
	if [ -n "$ROOT" ]; then
		systemctl "--root=$ROOT" "$@"
	else
		systemctl "$@"
	fi
}

systemd_manager_running()
{
	[ -z "$ROOT" ] && [ -d /run/systemd/system ]
}

reload_systemd_if_running()
{
	if systemd_manager_running; then
		run_systemctl daemon-reload
	fi
}

reload_udev_if_running()
{
	if [ -z "$ROOT" ] && [ -S /run/udev/control ]; then
		require_command udevadm
		udevadm control --reload-rules
	fi
}

depmod_target()
{
	if [ -n "$ROOT" ]; then
		depmod -b "$ROOT" -a "$KERNEL_RELEASE"
	else
		depmod -a "$KERNEL_RELEASE"
	fi
}

verify_target_module()
{
	module_path=$(root_path "/usr/lib/modules/$KERNEL_RELEASE/extra/aw86937-haptics.ko")
	[ -f "$module_path" ] && [ ! -L "$module_path" ] ||
		die "missing regular module for verified kernel release: $module_path"
	vermagic=$(modinfo -F vermagic "$module_path") ||
		die "cannot read module vermagic: $module_path"
	case "$vermagic" in
		"$KERNEL_RELEASE"|"$KERNEL_RELEASE "*) ;;
		*) die "module vermagic does not match verified kernel release: $vermagic" ;;
	esac
}

legacy_payload_present()
{
	for legacy_path in \
		/etc/systemd/system/y700-aw86937-haptics.service \
		/etc/systemd/system/multi-user.target.wants/y700-aw86937-haptics.service \
		/usr/lib/systemd/system/y700-aw86937-haptics.service \
		/lib/systemd/system/y700-aw86937-haptics.service \
		/etc/udev/rules.d/90-y700-haptics.rules \
		/usr/lib/udev/rules.d/90-y700-haptics.rules \
		/usr/local/bin/y700-aw86937-bind \
		/usr/local/sbin/y700-aw86937-bind; do
		if [ -e "$(root_path "$legacy_path")" ] || [ -L "$(root_path "$legacy_path")" ]; then
			return 0
		fi
	done
	return 1
}

read_managed_want_state()
{
	managed_want_state=$1
	managed_want_target=
	if [ -e "$managed_want_state" ] || [ -L "$managed_want_state" ]; then
		[ -f "$managed_want_state" ] && [ ! -L "$managed_want_state" ] ||
			die "managed systemd-want state is not a regular file: $managed_want_state"
		state_sample=$(mktemp "$(dirname -- "$managed_want_state")/.managed-want-state.XXXXXX") ||
			die "cannot create bounded managed systemd-want state sample"
		if ! dd if="$managed_want_state" of="$state_sample" bs=1 \
			count=$((MANAGED_WANT_STATE_MAX_BYTES + 1)) 2>/dev/null; then
			rm -f -- "$state_sample"
			die "cannot read managed systemd-want state: $managed_want_state"
		fi
		state_bytes=$(wc -c < "$state_sample") || {
			rm -f -- "$state_sample"
			die "cannot measure managed systemd-want state: $managed_want_state"
		}
		if [ "$state_bytes" -gt "$MANAGED_WANT_STATE_MAX_BYTES" ]; then
			rm -f -- "$state_sample"
			die "managed systemd-want state exceeds the size limit: $managed_want_state"
		fi
		if ! printf '%s\n' "$MANAGED_WANT_TARGET" | cmp -s "$state_sample" -; then
			rm -f -- "$state_sample"
			die "managed systemd-want state is malformed or has an unexpected target: $managed_want_state"
		fi
		rm -f -- "$state_sample"
		managed_want_target=$MANAGED_WANT_TARGET
	fi
}

record_managed_want_state()
{
	managed_want=$1
	managed_want_state=$(root_path /var/lib/tb321fu-haptics/managed-want)
	managed_want_preexisting=0
	managed_want_owned=0
	managed_want_created=0
	read_managed_want_state "$managed_want_state"
	if [ -L "$managed_want" ]; then
		current_target=$(readlink "$managed_want") ||
			die "cannot read existing systemd want: $managed_want"
		[ "$current_target" = "$MANAGED_WANT_TARGET" ] ||
			die "existing systemd want has an unexpected target: $managed_want"
		managed_want_preexisting=1
		if [ -n "$managed_want_target" ]; then
			if [ "$current_target" = "$managed_want_target" ]; then
				managed_want_owned=1
			else
				rm -f -- "$managed_want_state" ||
					die "cannot clear stale managed systemd-want state: $managed_want_state"
				managed_want_target=
			fi
		fi
	elif [ -e "$managed_want" ]; then
		die "refusing to replace non-symlink systemd want: $managed_want"
	else
		if [ -n "$managed_want_target" ]; then
			rm -f -- "$managed_want_state" ||
				die "cannot clear stale managed systemd-want state: $managed_want_state"
			managed_want_target=
		fi
	fi
}

record_owned_managed_want()
{
	managed_want_target=$(readlink "$managed_want") ||
		{ printf '%s\n' "tb321fu-haptics postinst: cannot read package-managed systemd want: $managed_want" >&2; return 1; }
	[ "$managed_want_target" = "$MANAGED_WANT_TARGET" ] ||
		{ printf '%s\n' "tb321fu-haptics postinst: package-managed systemd want has an unexpected target: $managed_want" >&2; return 1; }
	if ! install -d -m 0755 "$(dirname -- "$managed_want_state")"; then
		printf '%s\n' 'tb321fu-haptics postinst: cannot create managed systemd-want state directory' >&2
		return 1
	fi
	tmp_state=$(mktemp "$managed_want_state.tmp.XXXXXX") || {
		printf '%s\n' "tb321fu-haptics postinst: cannot create managed systemd-want state temporary file: $managed_want_state" >&2
		return 1
	}
	if ! ( umask 077; printf '%s\n' "$managed_want_target" > "$tmp_state" ); then
		rm -f -- "$tmp_state"
		printf '%s\n' "tb321fu-haptics postinst: cannot write managed systemd-want state: $managed_want_state" >&2
		return 1
	fi
	if ! chmod 0644 "$tmp_state"; then
		rm -f -- "$tmp_state"
		printf '%s\n' "tb321fu-haptics postinst: cannot set managed systemd-want state mode: $managed_want_state" >&2
		return 1
	fi
	if ! mv -f -- "$tmp_state" "$managed_want_state"; then
		rm -f -- "$tmp_state"
		printf '%s\n' "tb321fu-haptics postinst: cannot install managed systemd-want state: $managed_want_state" >&2
		return 1
	fi
}

rollback_new_managed_want()
{
	[ "$managed_want_created" = 1 ] || return 0
	if [ -L "$managed_want" ]; then
		rollback_target=$(readlink "$managed_want") ||
			die "cannot read newly created systemd want: $managed_want"
		[ "$rollback_target" = "$MANAGED_WANT_TARGET" ] ||
			die "newly created systemd want has an unexpected target: $managed_want"
		rm -f -- "$managed_want" ||
			die "cannot remove newly created systemd want: $managed_want"
	elif [ -e "$managed_want" ]; then
		die "refusing to remove non-symlink systemd want: $managed_want"
	fi
	if [ -e "$managed_want_state" ] || [ -L "$managed_want_state" ]; then
		[ -f "$managed_want_state" ] && [ ! -L "$managed_want_state" ] ||
			die "managed systemd-want state is not a regular file: $managed_want_state"
		rm -f -- "$managed_want_state" ||
			die "cannot remove newly created managed systemd-want state: $managed_want_state"
	fi
}

case "${1:-}" in
	configure) ;;
	*) exit 0 ;;
esac

require_command depmod
require_command modinfo
require_command systemctl
require_command cmp
require_command dd
require_command mktemp
require_command dirname
verify_target_module
if legacy_payload_present; then
	die 'legacy Y700 haptics payload remains; install the matching migrated daily package before tb321fu-haptics'
fi

depmod_target
reload_systemd_if_running
reload_udev_if_running
record_managed_want_state \
	"$(root_path /etc/systemd/system/multi-user.target.wants/tb321fu-haptics.service)"
if [ "$managed_want_preexisting" = 0 ] || [ "$managed_want_owned" = 1 ]; then
	[ "$managed_want_preexisting" = 1 ] || managed_want_created=1
	if ! run_systemctl enable tb321fu-haptics.service; then
		rollback_new_managed_want
		die 'cannot enable tb321fu-haptics.service'
	fi
fi
if ! run_systemctl is-enabled --quiet tb321fu-haptics.service; then
	rollback_new_managed_want
	die 'tb321fu-haptics.service is not enabled after enablement'
fi
if [ "$managed_want_preexisting" = 0 ] || [ "$managed_want_owned" = 1 ]; then
	if ! record_owned_managed_want; then
		rollback_new_managed_want
		die 'cannot persist managed systemd-want state'
	fi
fi
